<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Feliz cumpleaños, Laura</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,500&family=Caveat:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--noche:#0b1f4d;--azul:#2f6bd6;--cielo:#8fc0f5;--hielo:#e6f1fd}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{display:flex;align-items:center;justify-content:center;overflow:hidden;
  background:radial-gradient(ellipse at 50% 45%,rgba(255,255,255,.35),transparent 60%),
  linear-gradient(180deg,#0c2a6b 0%,#2a62c9 48%,#8fc0f5 100%);
  font-family:'Playfair Display',Georgia,serif}
#bokeh i{position:fixed;bottom:-12vh;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.7),rgba(255,255,255,0) 70%);
  animation:subir var(--t) linear infinite;animation-delay:var(--d)}
@keyframes subir{0%{transform:translateY(0);opacity:0}15%{opacity:.8}100%{transform:translateY(-125vh) translateX(var(--x));opacity:0}}
#lluvia i{position:fixed;top:-5vh;z-index:20;pointer-events:none;width:var(--w);height:calc(var(--w)*1.3);background:var(--c);
  border-radius:50% 0 50% 0;opacity:0;animation:caer var(--t) linear forwards}
@keyframes caer{10%{opacity:.9}100%{opacity:0;transform:translate(var(--x),112vh) rotate(540deg)}}

.esc{position:relative;container-type:inline-size;cursor:pointer;outline:none;
  width:min(92vw,460px,calc(92vh*5/7));aspect-ratio:5/7}
.esc:focus-visible{outline:3px solid #fff;outline-offset:10px;border-radius:16px}

/* flores */
.fl{position:absolute;z-index:8;pointer-events:none;width:calc(var(--s)*1cqw);aspect-ratio:1;
  rotate:calc(var(--r)*1deg);animation:mecer 5s ease-in-out infinite alternate;animation-delay:var(--d);
  filter:drop-shadow(0 6px 8px rgba(11,31,77,.35))}
.fl.h{z-index:7}
@keyframes mecer{from{rotate:calc(var(--r)*1deg - 5deg)}to{rotate:calc(var(--r)*1deg + 5deg)}}

/* sobre */
.env{position:absolute;left:8%;width:84%;top:30%;height:40%}
.fondo{z-index:1;border-radius:10px;background:linear-gradient(180deg,#1b479f,#2757b8);box-shadow:0 30px 50px rgba(11,31,77,.5)}
.bols{z-index:4;border-radius:10px;background:linear-gradient(160deg,#4f8ceb,#2b5fc7);
  clip-path:polygon(0 100%,0 0,50% 58%,100% 0,100% 100%)}
.bols::after{content:"";position:absolute;inset:0;background:rgba(255,255,255,.12);clip-path:polygon(0 100%,50% 58%,100% 100%)}
.flap{z-index:5;height:23.2%;background:linear-gradient(180deg,#7fb2f6,#4a86e8);clip-path:polygon(0 0,100% 0,50% 100%);
  transform-origin:top;transform:perspective(900px) rotateX(0);transition:transform .7s ease,z-index 0s .35s}
.sello{position:absolute;z-index:9;left:50%;top:53.2%;width:13cqw;aspect-ratio:1;translate:-50% -50%;border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#fff,#a9d0fa 60%,#6ea4ee);display:grid;place-items:center;
  box-shadow:0 5px 12px rgba(11,31,77,.4);animation:latido 2s ease-in-out infinite;transition:opacity .3s}
.sello svg{width:56%}
@keyframes latido{50%{scale:1.08}}
.para{position:absolute;z-index:6;left:8%;width:84%;top:62%;text-align:center;font-family:'Caveat',cursive;font-weight:700;
  font-size:clamp(1.5rem,9cqw,2.4rem);color:#fff;text-shadow:0 2px 6px rgba(11,31,77,.4);transition:opacity .3s}
.pista{position:absolute;z-index:6;left:0;right:0;top:76%;text-align:center;color:#fff;font-style:italic;
  font-size:clamp(.8rem,3.6cqw,1rem);animation:pul 2.2s ease-in-out infinite;transition:opacity .3s}
@keyframes pul{50%{opacity:.45}}

/* carta */
.papel{position:absolute;z-index:3;left:12%;width:76%;top:33%;height:30%;overflow:hidden;border-radius:10px;
  background:linear-gradient(180deg,#fff,#eef6ff);box-shadow:0 10px 30px rgba(11,31,77,.35);
  transition:top .7s,height .7s,left .7s,width .7s,z-index 0s .7s}
.papel::before{content:"";position:absolute;inset:2.5%;border:1px solid rgba(47,107,214,.4);border-radius:7px;pointer-events:none}
.in{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);padding:0 9%;text-align:center;color:var(--noche)}
.l{display:block;opacity:0;transform:translateY(10px);transition:opacity .4s,transform .4s}
h1.l{font-size:clamp(1.05rem,5.6cqw,1.6rem);color:var(--azul);font-weight:600}
.nombre{font-family:'Caveat',cursive;font-weight:700;line-height:1;font-size:clamp(2.8rem,16cqw,4.8rem);
  background:linear-gradient(90deg,#0b1f4d,#2f6bd6,#0b1f4d);-webkit-background-clip:text;background-clip:text;color:transparent;margin:.05em 0 .1em}
.sep{width:44%;height:auto;margin:0 auto .5em}
.v{font-style:italic;font-size:clamp(.76rem,3.5cqw,1rem);line-height:1.6;margin-bottom:.8em}
.v .l{opacity:0}
.fin{font-style:normal;font-weight:600;color:var(--azul)}
.firma{font-family:'Caveat',cursive;font-weight:700;font-size:clamp(1.4rem,7.5cqw,2.1rem);color:var(--azul);margin-top:.2em}

/* abierta */
.abierta .flap{transform:perspective(900px) rotateX(180deg);z-index:2}
.abierta .sello,.abierta .para,.abierta .pista{opacity:0}
.abierta .bols{opacity:0;transition:opacity .5s 1.15s}
.abierta .papel{top:6%;left:6%;width:88%;height:88%;z-index:6;transition:top 1s cubic-bezier(.2,.8,.2,1) .55s,height 1s cubic-bezier(.2,.8,.2,1) .55s,left 1s cubic-bezier(.2,.8,.2,1) .55s,width 1s cubic-bezier(.2,.8,.2,1) .55s,z-index 0s 1.1s}
.abierta .l{opacity:1;transform:none;transition-delay:calc(1.5s + var(--i)*.13s)}
.abierta .fondo{opacity:0;transition:opacity .5s 1.2s}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition-duration:.01s!important;transition-delay:0s!important}}
</style>
</head>
<body>
<div id="bokeh"></div><div id="lluvia"></div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs id="defs">
<linearGradient id="g1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a9d0fa"/><stop offset="1" stop-color="#2f6bd6"/></linearGradient>
<linearGradient id="g2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#eef6ff"/><stop offset="1" stop-color="#6ea4ee"/></linearGradient>
<linearGradient id="g3" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#d8eafd"/><stop offset="1" stop-color="#4d8be6"/></linearGradient>
<linearGradient id="g4" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff"/><stop offset="1" stop-color="#a9d0fa"/></linearGradient>
<linearGradient id="g5" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#1f4fa8"/><stop offset="1" stop-color="#5aa0e6"/></linearGradient>
<radialGradient id="au"><stop offset="0" stop-color="#fff8d6"/><stop offset="1" stop-color="#f0cc6e"/></radialGradient>
</defs></svg>

<div class="esc" id="esc" role="button" tabindex="0" aria-expanded="false" aria-label="Abrir la carta de cumpleaños para Laura">
  <div class="env fondo"></div>
  <div class="env flap"></div>
  <div class="env bols"></div>
  <div class="sello"><svg viewBox="0 0 24 24" fill="#2f6bd6"><path d="M12 21s-7.5-4.6-9.6-9.2C1 8.7 2.9 5 6.3 5c2 0 3.700 1.100 4.700 2.700h2C14 6.100 15.700 5 17.700 5c3.400 0 5.300 3.700 3.900 6.800C19.500 16.400 12 21 12 21z"/></svg></div>
  <div class="para">Para Laura</div>
  <div class="pista">Toca la carta</div>

  <div class="papel"><div class="in">
    <h1 class="l" style="--i:0">¡Feliz cumpleaños!</h1>
    <div class="nombre l" style="--i:1">Laura</div>
    <svg class="sep l" style="--i:2" viewBox="0 0 120 20"><line x1="0" y1="10" x2="44" y2="10" stroke="#8fc0f5"/><line x1="76" y1="10" x2="120" y2="10" stroke="#8fc0f5"/><use href="#fD" transform="translate(50 0) scale(.2)"/></svg>
    <p class="v"><span class="l" style="--i:3">Hoy el cielo se vistió de fiesta,</span><span class="l" style="--i:4">y las flores te vienen a abrazar;</span><span class="l" style="--i:5">que la vida te sea una orquesta</span><span class="l" style="--i:6">y tus sueños aprendan a volar.</span></p>
    <p class="v"><span class="l" style="--i:7">Que no falten risas en tu camino,</span><span class="l" style="--i:8">ni un abrazo cuando quieras soñar;</span><span class="l" style="--i:9">que te guíe siempre tu destino</span><span class="l" style="--i:10">y te sobren motivos para brillar.</span></p>
    <p class="v fin"><span class="l" style="--i:11">Feliz cumpleaños, Laura querida,</span><span class="l" style="--i:12">¡que sea el año más bonito de tu vida!</span></p>
    <div class="firma l" style="--i:13">Con cariño, Axel</div>
  </div></div>
</div>

<script>
const $=s=>document.querySelector(s),esc=$('#esc');
const D="M50 52C28 40 30 8 50 3C70 8 72 40 50 52Z";
const R=(n,f,s,o)=>Array.from({length:n},(_,i)=>`<path d="${D}" fill="${f}" transform="rotate(${o+i*360/n} 50 50) translate(50 50) scale(${s}) translate(-50 -50)"/>`).join('');
const C='<circle cx="50" cy="50" r="7" fill="url(#au)"/><g fill="#d9a93a"><circle cx="47" cy="48" r="1.2"/><circle cx="53" cy="49" r="1.2"/><circle cx="50" cy="54" r="1.2"/></g>';
$('#defs').insertAdjacentHTML('beforeend',
`<g id="fA">${R(8,'url(#g1)',1,0)}${R(8,'url(#g2)',.68,22)}${R(6,'url(#g1)',.38,0)}${C}</g>
<g id="fB">${R(6,'url(#g3)',1,15)}${R(6,'url(#g4)',.66,45)}${C}</g>
<g id="fD">${Array.from({length:16},(_,i)=>`<path d="M50 50C45 38 46 18 50 8C54 18 55 38 50 50Z" fill="#fff" stroke="#9cc6f3" stroke-width=".8" transform="rotate(${i*22.5} 50 50)"/>`).join('')}<circle cx="50" cy="50" r="8" fill="url(#au)"/></g>
<g id="lf"><path d="M8 92C6 44 42 8 94 8C94 58 56 94 8 92Z" fill="url(#g5)"/><path d="M12 88C38 60 60 36 90 12" stroke="#cfe5fb" stroke-width="1.6" fill="none" opacity=".7"/></g>`);
// [forma, tamaño(cqw), posición, rotación, retardo]
const items=[
['lf',22,'top:4%;left:-6%',-20,.2],['lf',20,'top:-8%;left:14%',40,.6],['lf',20,'top:-6%;right:6%',-50,.3],
['lf',18,'top:42%;left:-9%',-60,.9],['lf',18,'top:40%;right:-9%',60,.5],['lf',22,'bottom:2%;left:-5%',-100,.1],
['lf',20,'bottom:-8%;left:30%',-140,.7],['lf',22,'bottom:3%;right:-5%',100,.4],
['fA',34,'top:-7%;left:-10%',10,0],['fB',22,'top:-3%;left:20%',30,.8],['fD',17,'top:3%;left:36%',0,.4],
['fA',27,'top:-6%;right:-9%',-15,.3],['fD',19,'top:11%;right:6%',15,1],['fB',20,'top:33%;left:-11%',0,.6],
['fA',18,'top:47%;right:-10%',25,.2],['fD',15,'top:62%;left:-6%',0,.9],['fA',31,'bottom:-6%;left:-9%',-10,.5],
['fD',18,'bottom:3%;left:24%',20,.1],['fB',24,'bottom:-4%;left:40%',-20,1.1],['fD',15,'bottom:5%;right:27%',0,.7],
['fA',33,'bottom:-7%;right:-10%',15,.2],['fB',18,'bottom:17%;right:-8%',-25,.8]];
items.forEach(([k,s,p,r,d])=>esc.insertAdjacentHTML('beforeend',`<svg class="fl${k=='lf'?' h':''}" viewBox="0 0 100 100" style="--s:${s};${p};--r:${r};--d:${d}s"><use href="#${k}"/></svg>`));
// luces flotantes
for(let i=0;i<18;i++){const b=document.createElement('i'),z=14+Math.random()*50;
b.style.cssText=`left:${Math.random()*100}%;width:${z}px;height:${z}px;--t:${12+Math.random()*14}s;--d:${-Math.random()*20}s;--x:${(Math.random()-.5)*80}px`;$('#bokeh').appendChild(b)}
// pétalos al abrir
function lluvia(){const c=['#8fc0f5','#4d8be6','#cfe5fb','#2f6bd6','#fff'];
for(let i=0;i<30;i++){const p=document.createElement('i');
p.style.cssText=`left:${Math.random()*100}%;--w:${6+Math.random()*10}px;--c:${c[i%5]};--x:${(Math.random()-.5)*160}px;--t:${3.5+Math.random()*3}s;animation-delay:${.8+Math.random()*1.2}s`;
$('#lluvia').appendChild(p);setTimeout(()=>p.remove(),9000)}}
const alternar=()=>{const o=esc.classList.toggle('abierta');esc.setAttribute('aria-expanded',o);
esc.setAttribute('aria-label',o?'Carta abierta. Toca para cerrar':'Abrir la carta de cumpleaños para Laura');if(o)lluvia()};
esc.addEventListener('click',alternar);
esc.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();alternar()}});
</script>
</body>
</html>
